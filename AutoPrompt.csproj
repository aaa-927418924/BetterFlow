<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BetterFlow</AssemblyName>
    <RootNamespace>BetterFlow</RootNamespace>
    <AssemblyTitle>Better Flow</AssemblyTitle>
    <Product>Better Flow</Product>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\BetterFlow.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\BetterFlow.png" />
    <Resource Include="Assets\BetterFlow.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\silero_vad.onnx" LogicalName="BetterFlow.Assets.silero_vad.onnx" />
    <EmbeddedResource Include="Assets\SileroVAD-LICENSE.txt" LogicalName="BetterFlow.Assets.SileroVAD-LICENSE.txt" />
    <EmbeddedResource Include="Assets\gpt-live.html" LogicalName="BetterFlow.Assets.gpt-live.html" />
    <EmbeddedResource Include="Assets\universfield-gadget-activation-250072.mp3"
                      LogicalName="BetterFlow.Assets.activation.mp3"
                      Condition="Exists('Assets\universfield-gadget-activation-250072.mp3')" />
  </ItemGroup>
</Project>
