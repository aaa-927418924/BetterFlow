<Window x:Class="BetterFlow.AnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:BetterFlow.Services"
        Width="500" Height="560" MinWidth="320" MinHeight="240" MaxHeight="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AnswerGlassTintBrush" Color="#99111111" />
    </Window.Resources>
    <Grid x:Name="GlassRoot" SizeChanged="GlassRoot_SizeChanged">
        <Grid.Clip>
            <RectangleGeometry Rect="0,0,500,560" RadiusX="19" RadiusY="19" />
        </Grid.Clip>
        <Image x:Name="GlassBackdropImage" Margin="-12" Stretch="Fill" Visibility="Collapsed"
               IsHitTestVisible="False">
            <Image.Effect>
                <BlurEffect Radius="32" KernelType="Gaussian" RenderingBias="Quality" />
            </Image.Effect>
        </Image>
        <Border Background="{StaticResource AnswerGlassTintBrush}" CornerRadius="19"
                IsHitTestVisible="False" />
        <Border Background="Transparent" BorderBrush="#2B2B2B" BorderThickness="2.5"
                CornerRadius="19" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Viewbox Width="42" Height="40" Stretch="Uniform" VerticalAlignment="Center"
                             Margin="0,0,12,0" AutomationProperties.Name="Better Flow">
                        <Canvas Width="82" Height="77">
                            <Border Width="82" Height="77" Background="White" CornerRadius="28" />
                            <Rectangle Canvas.Left="35" Canvas.Top="15" Width="11" Height="46"
                                       RadiusX="5.5" RadiusY="5.5" Fill="#2B2B2B" />
                            <Rectangle Canvas.Left="17" Canvas.Top="18" Width="11" Height="41"
                                       RadiusX="5.5" RadiusY="5.5" Fill="#2B2B2B" />
                            <Rectangle Canvas.Left="53" Canvas.Top="24" Width="11" Height="29"
                                       RadiusX="5.5" RadiusY="5.5" Fill="#2B2B2B" />
                        </Canvas>
                    </Viewbox>
                </DockPanel>
                <ScrollViewer x:Name="AnswerScrollViewer" Grid.Row="1" Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel>
                        <TextBox x:Name="AnswerContent" Text="" FontFamily="Yu Gothic UI" FontSize="15"
                                 TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 Background="Transparent" Foreground="{StaticResource TextBrush}"
                                 BorderThickness="0" Padding="0" CaretBrush="{StaticResource TextBrush}"
                                 HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                                 FocusVisualStyle="{x:Null}" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel x:Name="SourceSection" Visibility="Collapsed" Margin="0,18,0,0">
                            <TextBlock Text="出典" FontFamily="Yu Gothic UI" FontSize="11"
                                       FontWeight="SemiBold" Foreground="#C8C8C8" Margin="0,0,0,8" />
                            <ItemsControl x:Name="AnswerSourceItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}" Click="SourceCard_Click" Padding="0"
                                                Margin="0,0,0,7" Background="Transparent" BorderThickness="0"
                                                HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                ToolTip="{Binding Url}"
                                                AutomationProperties.Name="{Binding Title}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="CardSurface" Background="#2A2A2A"
                                                            BorderBrush="#454545" BorderThickness="1"
                                                            CornerRadius="9" Padding="10,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontFamily="Yu Gothic UI" FontSize="12"
                                                                       FontWeight="Medium" Foreground="#F4F4F4"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Host}"
                                                                       FontFamily="Yu Gothic UI" FontSize="10"
                                                                       Foreground="#A8A8A8" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CardSurface" Property="Background" Value="#363636" />
                                                            <Setter TargetName="CardSurface" Property="BorderBrush" Value="#777777" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="CardSurface" Property="Background" Value="#222222" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
