<Window x:Class="BetterFlow.AnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" Height="560" MinWidth="320" MinHeight="240" MaxHeight="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="Transparent">
        <Border Background="#202020" BorderBrush="#2B2B2B" BorderThickness="2.5"
                CornerRadius="19" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="×" Width="30" Height="30"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="CloseButton_Click" ToolTip="回答を閉じる"
                            AutomationProperties.Name="回答を閉じる" />
                    <Viewbox Width="42" Height="40" Stretch="Uniform" VerticalAlignment="Center"
                             Margin="0,0,12,0" AutomationProperties.Name="Better Flow">
                        <Canvas Width="82" Height="77">
                            <Border Width="82" Height="77" Background="White" CornerRadius="28" />
                            <Rectangle Canvas.Left="35" Canvas.Top="15" Width="11" Height="46"
                                       RadiusX="5.5" RadiusY="5.5" Fill="#2B2B2B" />
                            <Rectangle Canvas.Left="17" Canvas.Top="18" Width="11" Height="41"
                                       RadiusX="5.5" RadiusY="5.5" Fill="#2B2B2B" />
                            <Rectangle Canvas.Left="53" Canvas.Top="24" Width="11" Height="29"
                                       RadiusX="5.5" RadiusY="5.5" Fill="#2B2B2B" />
                        </Canvas>
                    </Viewbox>
                </DockPanel>
                <ScrollViewer x:Name="AnswerScrollViewer" Grid.Row="1" Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False" ScrollChanged="AnswerScrollViewer_ScrollChanged">
                    <TextBlock x:Name="AnswerContent" Text="" FontSize="15" LineHeight="23"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
