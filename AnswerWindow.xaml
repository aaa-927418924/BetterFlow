<Window x:Class="BetterFlow.AnswerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" Height="560" MinWidth="320" MinHeight="240" MaxHeight="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="Transparent">
        <Border Background="#202020" BorderBrush="#2B2B2B" BorderThickness="2.5"
                CornerRadius="19" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="×" Width="30" Height="30"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="CloseButton_Click" ToolTip="回答を閉じる"
                            AutomationProperties.Name="回答を閉じる" />
                    <TextBlock x:Name="AnswerTitle" Text="回答" FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                </DockPanel>
                <TextBlock x:Name="AnswerStatus" Grid.Row="1" Text=""
                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                           Margin="0,8,0,10" AutomationProperties.LiveSetting="Polite" />
                <ScrollViewer x:Name="AnswerScrollViewer" Grid.Row="2"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False" ScrollChanged="AnswerScrollViewer_ScrollChanged">
                    <TextBlock x:Name="AnswerContent" Text="" FontSize="15" LineHeight="23"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
