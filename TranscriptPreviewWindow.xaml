<Window x:Class="BetterFlow.TranscriptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" MinHeight="42" MaxHeight="126" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" WindowStartupLocation="Manual" Focusable="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="#202020" BorderBrush="#303030" BorderThickness="2"
            CornerRadius="19" Padding="13,9" IsHitTestVisible="False">
        <ScrollViewer MaxHeight="98" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False">
            <Border x:Name="PreviewHighlight" Background="Transparent" CornerRadius="6"
                    Padding="0" HorizontalAlignment="Stretch">
                <TextBlock x:Name="PreviewText" FontFamily="Yu Gothic UI" FontSize="13"
                           Foreground="#F4F4F4" TextWrapping="Wrap" />
            </Border>
        </ScrollViewer>
    </Border>
</Window>
