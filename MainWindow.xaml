<Window x:Class="AutoPrompt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Prompt" Width="760" Height="900" MinWidth="680" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="34,28,34,28">
                <DockPanel Margin="0,0,0,24" LastChildFill="False">
                    <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                        <Grid>
                            <Rectangle Width="4" Height="13" RadiusX="2" RadiusY="2" Fill="White" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-12,0,0,0" />
                            <Rectangle Width="4" Height="23" RadiusX="2" RadiusY="2" Fill="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Rectangle Width="4" Height="16" RadiusX="2" RadiusY="2" Fill="White" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="12,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Auto Prompt" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="音声入力を、短い指示文に" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="{StaticResource AccentPaleBrush}" CornerRadius="999" Padding="12,7" VerticalAlignment="Center">
                        <TextBlock Text="日本語 · ローカルASR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </DockPanel>

                <TextBlock Text="話すだけで、入力を整える" FontSize="30" FontWeight="Bold" LineHeight="40" Margin="0,0,0,8" />
                <TextBlock Text="ショートカットで録音し、音声はPC内で文字起こし。OpenCodeが10行以下のプロンプトに整え、今フォーカスしている欄へ貼り付けます。" FontSize="14" Foreground="{StaticResource MutedBrush}" LineHeight="22" Margin="0,0,0,22" />

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="セットアップ" FontSize="17" FontWeight="Bold" Margin="0,0,0,5" />
                        <TextBlock Text="最初の一度だけ、OpenCodeと日本語音声モデルを取得して起動します。必要なファイルはこのアプリ専用のユーザー領域に保存します。" FontSize="13" Foreground="{StaticResource MutedBrush}" LineHeight="20" Margin="0,0,0,18" />

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F7F9FC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="13,11">
                                <StackPanel>
                                    <TextBlock Text="OpenCode" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock x:Name="OpenCodeStatus" Text="未取得 · 約60 MB" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#F7F9FC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="13,11">
                                <StackPanel>
                                    <TextBlock Text="Parakeet 日本語" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock x:Name="ModelStatus" Text="未取得 · ダウンロード約490 MB" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ProgressBar x:Name="SetupProgress" Height="8" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" Background="#E7EDF5" BorderThickness="0" />
                        <TextBlock x:Name="SetupStatus" Text="初回セットアップを開始してください。" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,14" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="SetupButton" Content="ダウンロードして音声モデルを起動" Style="{StaticResource PrimaryButtonStyle}" Click="SetupButton_Click" />
                    </StackPanel>
                </Border>

                <Border x:Name="ZenPanel" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12" LastChildFill="False">
                            <TextBlock Text="文章変換モデル" FontSize="17" FontWeight="Bold" />
                            <Border DockPanel.Dock="Right" Background="{StaticResource SuccessPaleBrush}" CornerRadius="999" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="Muse Spark 1.3 Contributor" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                            </Border>
                        </DockPanel>
                        <Border Background="{StaticResource WarningPaleBrush}" CornerRadius="12" Padding="13,11" Margin="0,0,0,14">
                            <TextBlock Foreground="{StaticResource WarningBrush}" FontSize="12" LineHeight="19" Text="音声はローカルで処理します。文字起こしと生成結果はOpenCode Zenへ送信されます。このContributorモデルでは、入力と出力がMetaの将来モデルの学習に使われる条件です。無料提供や利用地域は変わる場合があります。内容を確認してからAPIキーを登録してください。" />
                        </Border>
                        <TextBlock Text="Zen APIキー" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <PasswordBox x:Name="ZenApiKeyBox" Height="42" Padding="12,9" FontSize="14" FontFamily="Yu Gothic UI" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" />
                        <CheckBox x:Name="ConsentCheck" Margin="0,12,0,10" FontSize="12" Foreground="{StaticResource TextBrush}" Content="データ利用条件を確認し、このモデルへ文字起こしを送信することに同意します。" />
                        <DockPanel LastChildFill="False">
                            <Button x:Name="SaveKeyButton" Content="同意してキーを保存" Style="{StaticResource SecondaryButtonStyle}" Padding="16,10" Click="SaveKeyButton_Click" />
                            <Button Content="Zenのキーを取得" Style="{StaticResource SecondaryButtonStyle}" Padding="15,10" Margin="10,0,0,0" Click="OpenZenButton_Click" />
                            <TextBlock x:Name="ZenStatus" DockPanel.Dock="Right" Text="未接続" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ReadyPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12" LastChildFill="False">
                            <TextBlock Text="音声入力" FontSize="17" FontWeight="Bold" />
                            <Border DockPanel.Dock="Right" Background="{StaticResource SuccessPaleBrush}" CornerRadius="999" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock x:Name="ReadyBadge" Text="準備完了" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                            </Border>
                        </DockPanel>
                        <TextBlock Text="入力したい欄にカーソルを置き、ショートカットを押して話してください。同じキーでもう一度押すと停止します。" FontSize="13" Foreground="{StaticResource MutedBrush}" LineHeight="20" Margin="0,0,0,13" />
                        <Border Background="{StaticResource AccentPaleBrush}" CornerRadius="12" Padding="14,10" Margin="0,0,0,13">
                            <TextBlock Text="Ctrl + Shift + Space" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <DockPanel LastChildFill="False">
                            <Button x:Name="RecordButton" Content="録音を開始" Style="{StaticResource SecondaryButtonStyle}" Padding="16,10" Click="RecordButton_Click" />
                            <TextBlock x:Name="RuntimeStatus" DockPanel.Dock="Right" Text="待機中" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ResultPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10" LastChildFill="False">
                            <TextBlock Text="直前のプロンプト" FontSize="15" FontWeight="Bold" />
                            <Button Content="コピー" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" DockPanel.Dock="Right" Click="CopyResultButton_Click" />
                        </DockPanel>
                        <TextBox x:Name="ResultBox" MinHeight="72" MaxHeight="180" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="11" BorderBrush="{StaticResource BorderBrush}" Background="#FBFCFE" FontFamily="Yu Gothic UI" FontSize="13" />
                    </StackPanel>
                </Border>

                <TextBlock Text="OpenCode CLIと音声モデルは初回起動時に公式配布元から取得します。モデルの変換・性能は公開資料を根拠に選定し、このアプリで独自の精度比較は行いません。" FontSize="11" Foreground="{StaticResource MutedBrush}" LineHeight="17" Margin="2,0,2,12" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
