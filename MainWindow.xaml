<Window x:Class="BetterFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Better Flow"
        Icon="pack://application:,,,/BetterFlow;component/Assets/BetterFlow.ico"
        Width="640" Height="640" MinWidth="640" MinHeight="640" MaxWidth="640" MaxHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid Background="Transparent">
        <Border Background="{StaticResource OuterPanelBrush}"
                CornerRadius="34" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="30" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragRegion_MouseLeftButtonDown">
                        <Image Source="pack://application:,,,/BetterFlow;component/Assets/BetterFlow.png"
                               Width="62" Height="58" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="Better Flow" />
                        <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource WindowControlButtonStyle}" Click="CloseButton_Click"
                                ToolTip="閉じる" AutomationProperties.Name="閉じる" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,16,0,14" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Text="起動には初回セットアップが必要です。"
                                   FontSize="23" FontWeight="Normal" LineHeight="34" />
                        <TextBlock x:Name="BodyText" Text="日本語音声モデルとOpenCodeを自動で準備します。&#10;OpenCode Zenの利用には別途サインインが必要です。"
                                   FontSize="16" LineHeight="22" Margin="0,20,0,0" />
                        <TextBlock x:Name="CapacityText" Text="必要な空き容量: 約1.2 GB"
                                   FontSize="15" Margin="0,18,0,0" />
                        <StackPanel x:Name="ShortcutSettingsPanel" Margin="0,18,0,0" Visibility="Collapsed">
                            <TextBlock Text="ショートカットキー" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                            <DockPanel Margin="0,4,0,0" LastChildFill="True">
                                <Button x:Name="ShortcutChangeButton" DockPanel.Dock="Right" Content="変更"
                                        MinWidth="88" Height="40" Padding="14,0" Margin="12,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}" FontSize="14"
                                        Cursor="Hand" Click="ShortcutChangeButton_Click"
                                        AutomationProperties.Name="ショートカットキーを変更" />
                                <TextBlock x:Name="ShortcutCurrentText" FontSize="17" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="ShortcutCaptureStatus" Text="" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" LineHeight="18"
                                       Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite" />
                            <DockPanel Margin="0,12,0,0" LastChildFill="True">
                                <ToggleButton x:Name="AiModeToggle" DockPanel.Dock="Right"
                                              Style="{StaticResource ModeToggleStyle}" Click="AiModeToggle_Click"
                                              IsChecked="False"
                                              AutomationProperties.Name="AIによる文章整形モード"
                                              AutomationProperties.HelpText="オフは文字起こしのみです。オンでは通常の認識文を整え、選択文編集時は音声指示で選択文を編集します。" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="AiModeLabel" Text="AIによる文章整形" FontSize="14" />
                                    <TextBlock x:Name="AiModeDescription" Text="オフ: 文字起こしのみ"
                                               FontSize="12" Foreground="{StaticResource MutedBrush}"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel x:Name="MicrophoneSettingsPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock Text="音声入力デバイス" FontSize="14" FontWeight="SemiBold" />
                            <DockPanel Margin="0,8,0,0" LastChildFill="True">
                                <Button x:Name="RefreshMicrophoneDevicesButton" DockPanel.Dock="Right" Content="再読み込み"
                                        MinWidth="92" Height="40" Padding="8,0" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="RefreshMicrophoneDevices_Click" AutomationProperties.Name="音声入力デバイス一覧を再読み込み" />
                                <ComboBox x:Name="MicrophoneDeviceCombo" IsEditable="False" MinHeight="40"
                                          Background="#333333" Foreground="#F4F4F4" BorderBrush="#686868"
                                          FontFamily="Yu Gothic UI" FontSize="13"
                                          ItemTemplate="{StaticResource AudioInputDisplayNameTemplate}"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          SelectionChanged="MicrophoneDeviceCombo_SelectionChanged"
                                          AutomationProperties.Name="音声入力デバイス" />
                            </DockPanel>
                            <TextBlock x:Name="MicrophoneDeviceStatus" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <StackPanel x:Name="OpenCodeModelSettingsPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock Text="OpenCodeモデル" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="モデル" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                            <DockPanel LastChildFill="True">
                                <Button x:Name="RefreshOpenCodeModelsButton" DockPanel.Dock="Right" Content="一覧を更新"
                                        MinWidth="92" Height="40" Padding="8,0" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="RefreshOpenCodeModels_Click" AutomationProperties.Name="OpenCodeモデル一覧を更新" />
                                <ComboBox x:Name="OpenCodeModelCombo" IsEditable="False" MinHeight="40"
                                          Background="#333333" Foreground="#F4F4F4" BorderBrush="#686868"
                                          FontFamily="Yu Gothic UI" FontSize="13"
                                          ItemTemplate="{StaticResource DropdownDisplayNameTemplate}"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          SelectionChanged="OpenCodeModelCombo_SelectionChanged"
                                          AutomationProperties.Name="OpenCode Desktopのモデル" />
                            </DockPanel>
                            <TextBlock x:Name="OpenCodeModelModeHint"
                                       Text="AIモード中はモデルを変更できません。変更するにはAIモードをオフにしてください。"
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="OpenCodeModelStatus" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <StackPanel x:Name="CorrectionDictionarySettingsPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock Text="用語辞書" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="登録した単語はAI整形時に自動で使います。"
                                       FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,8" />
                            <TextBlock Text="正しい表記" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                            <Border Background="#333333" BorderBrush="#686868" BorderThickness="1"
                                    CornerRadius="10" Height="42" Padding="10,4">
                                <TextBox x:Name="DictionaryPreferredSpellingBox" BorderThickness="0"
                                         Background="Transparent" Foreground="#F4F4F4"
                                         FontFamily="Yu Gothic UI" FontSize="13" MaxLength="100"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="辞書に登録する正しい表記" />
                            </Border>
                            <TextBlock Text="誤認識・別表記（任意。複数は「、」区切り）"
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,4" />
                            <Border Background="#333333" BorderBrush="#686868" BorderThickness="1"
                                    CornerRadius="10" Height="42" Padding="10,4">
                                <TextBox x:Name="DictionaryAlternativesBox" BorderThickness="0"
                                         Background="Transparent" Foreground="#F4F4F4"
                                         FontFamily="Yu Gothic UI" FontSize="13" MaxLength="400"
                                         VerticalContentAlignment="Center"
                                         AutomationProperties.Name="辞書に登録する誤認識・別表記" />
                            </Border>
                            <Button Content="単語を登録" Height="38" HorizontalAlignment="Right"
                                    MinWidth="112" Padding="12,0" Margin="0,8,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="AddCorrectionDictionaryEntry_Click"
                                    AutomationProperties.Name="用語辞書に単語を登録" />
                            <TextBlock x:Name="CorrectionDictionaryStatus" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"
                                       AutomationProperties.LiveSetting="Polite" />
                            <ItemsControl x:Name="CorrectionDictionaryItems" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2B2B2B" CornerRadius="10" Padding="8" Margin="0,0,0,6">
                                            <DockPanel LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Content="削除" Tag="{Binding}"
                                                        Height="32" MinWidth="60" Padding="8,0" Margin="8,0,0,0"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Click="RemoveCorrectionDictionaryEntry_Click"
                                                        AutomationProperties.Name="この辞書項目を削除" />
                                                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                                                           FontSize="12" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel x:Name="SelectedTextAnswerSettingsPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock Text="選択した文章への回答方法" FontSize="14" FontWeight="SemiBold" />
                            <ComboBox x:Name="SelectedTextAnswerModeCombo" IsEditable="False" MinHeight="40"
                                      Background="#333333" Foreground="#F4F4F4" BorderBrush="#686868"
                                      FontFamily="Yu Gothic UI" FontSize="13" Margin="0,8,0,0"
                                      Style="{StaticResource DarkComboBoxStyle}"
                                      SelectionChanged="SelectedTextAnswerModeCombo_SelectionChanged"
                                      AutomationProperties.Name="選択文章への回答方法">
                                <ComboBoxItem Content="OpenCodeのテキスト回答" Tag="opencode" />
                                <ComboBoxItem Content="GPT Liveの音声会話" Tag="gpt-live" />
                            </ComboBox>
                            <DockPanel x:Name="GptLiveSignInPanel" Margin="0,8,0,0" LastChildFill="True"
                                       Visibility="Collapsed">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="GptLiveSignInButton" Content="サインイン" MinWidth="96" Height="38"
                                            Padding="12,0" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="GptLiveSignInButton_Click" AutomationProperties.Name="ChatGPTにサインイン" />
                                    <Button x:Name="GptLiveSignOutButton" Content="サインアウト" MinWidth="96" Height="38"
                                            Padding="12,0" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                            Click="GptLiveSignOutButton_Click" AutomationProperties.Name="ChatGPTからサインアウト" />
                                </StackPanel>
                                <TextBlock x:Name="GptLiveSignInStatus" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                            </DockPanel>
                        </StackPanel>
                        <ProgressBar x:Name="SetupProgress" Height="5" Minimum="0" Maximum="100" Value="0"
                                     Visibility="Collapsed" Foreground="#EAEAEA" Background="#555555"
                                     BorderThickness="0" Margin="0,20,0,0" />
                        <TextBlock x:Name="SetupStatus" Text="" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   LineHeight="18" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="RuntimeStatus" Text="" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   LineHeight="18" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />

                    </StackPanel>
                    </ScrollViewer>

                    <Button x:Name="ActionButton" Grid.Row="2" Content="Setup" Width="210" Height="56"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButtonStyle}"
                            Click="ActionButton_Click" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
