<Window x:Class="AutoPrompt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Prompt"
        Icon="pack://application:,,,/AutoPrompt;component/Assets/AutoPrompt.ico"
        Width="640" Height="640" MinWidth="640" MinHeight="640" MaxWidth="640" MaxHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid Background="Transparent">
        <Border Background="{StaticResource OuterPanelBrush}"
                CornerRadius="34" Padding="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="30" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragRegion_MouseLeftButtonDown">
                        <Image Source="pack://application:,,,/AutoPrompt;component/Assets/AutoPrompt.png"
                               Width="62" Height="58" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="Auto Prompt" />
                        <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource WindowControlButtonStyle}" Click="CloseButton_Click"
                                ToolTip="閉じる" AutomationProperties.Name="閉じる" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,16,0,14" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Text="起動には初回セットアップが必要です。"
                                   FontSize="23" FontWeight="Normal" LineHeight="34" />
                        <TextBlock x:Name="BodyText" Text="モデルのダウンロード後に&#10;アプリが使用可能になります。"
                                   FontSize="16" LineHeight="22" Margin="0,20,0,0" />
                        <TextBlock x:Name="CapacityText" Text="必要な空き容量: 約1.2 GB"
                                   FontSize="15" Margin="0,18,0,0" />
                        <StackPanel x:Name="ShortcutSettingsPanel" Margin="0,18,0,0" Visibility="Collapsed">
                            <TextBlock Text="ショートカットキー" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                            <DockPanel Margin="0,4,0,0" LastChildFill="True">
                                <Button x:Name="ShortcutChangeButton" DockPanel.Dock="Right" Content="変更"
                                        MinWidth="88" Height="40" Padding="14,0" Margin="12,0,0,0"
                                        Background="#383838" Foreground="#F4F4F4" BorderBrush="#686868"
                                        BorderThickness="1" FontFamily="Yu Gothic UI" FontSize="14"
                                        Cursor="Hand" Click="ShortcutChangeButton_Click"
                                        AutomationProperties.Name="ショートカットキーを変更" />
                                <TextBlock x:Name="ShortcutCurrentText" FontSize="17" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="ShortcutCaptureStatus" Text="" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" LineHeight="18"
                                       Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite" />
                            <DockPanel Margin="0,12,0,0" LastChildFill="True">
                                <ToggleButton x:Name="AiModeToggle" DockPanel.Dock="Right"
                                              Style="{StaticResource ModeToggleStyle}" Click="AiModeToggle_Click"
                                              IsChecked="False"
                                              AutomationProperties.Name="AIによる文章整形モード"
                                              AutomationProperties.HelpText="オフは文字起こしのみです。オンにすると認識した文章を選択中のAIサービスで整えます。" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="AiModeLabel" Text="AIによる文章整形" FontSize="14" />
                                    <TextBlock x:Name="AiModeDescription" Text="オフ: 文字起こしのみ"
                                               FontSize="12" Foreground="{StaticResource MutedBrush}"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel x:Name="AiProviderSettingsPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock Text="AIサービスとモデル" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="AIモードをオフにしてから設定を変更できます。音声は送信せず、文字起こしテキストだけを選択したサービスへ送信します。"
                                       FontSize="12" Foreground="{StaticResource MutedBrush}" LineHeight="17" Margin="0,4,0,0" />
                            <TextBlock Text="サービス" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                            <ComboBox x:Name="AiProviderCombo" MinHeight="40" Padding="8,5"
                                      Background="#333333" Foreground="#F4F4F4" BorderBrush="#686868"
                                      FontFamily="Yu Gothic UI" FontSize="14"
                                      SelectionChanged="AiProviderCombo_SelectionChanged"
                                      AutomationProperties.Name="文章整形に使うAIサービス">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#333333" />
                                        <Setter Property="Foreground" Value="#F4F4F4" />
                                        <Setter Property="Padding" Value="8,6" />
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" Value="#555555" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#444444" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <TextBlock x:Name="AiProviderDescription" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       LineHeight="17" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite" />

                            <StackPanel x:Name="ZenProviderPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock Text="モデル" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="RefreshZenModelsButton" DockPanel.Dock="Right" Content="一覧を更新"
                                            MinWidth="92" Height="40" Padding="8,0" Margin="8,0,0,0"
                                            Background="#383838" Foreground="#F4F4F4" BorderBrush="#686868"
                                            BorderThickness="1" FontFamily="Yu Gothic UI" FontSize="12" Cursor="Hand"
                                            Click="RefreshZenModels_Click" AutomationProperties.Name="OpenCode Zen Freeのモデル一覧を更新" />
                                    <ComboBox x:Name="ZenModelCombo" IsEditable="True" MinHeight="40" Padding="8,5"
                                              Background="#333333" Foreground="#F4F4F4" BorderBrush="#686868"
                                              FontFamily="Yu Gothic UI" FontSize="13" DisplayMemberPath="DisplayName"
                                              TextSearch.TextPath="ModelId" AutomationProperties.Name="OpenCode Zen FreeのモデルID">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Background" Value="#333333" />
                                                <Setter Property="Foreground" Value="#F4F4F4" />
                                                <Setter Property="Padding" Value="8,6" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter Property="Background" Value="#555555" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#444444" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock x:Name="ZenModelStatus" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>

                            <StackPanel x:Name="ApiProviderPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock Text="モデルID" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="ApiModelTextBox" MinHeight="40" Padding="8,7"
                                         Background="#333333" Foreground="#F4F4F4" CaretBrush="#F4F4F4"
                                         BorderBrush="#686868" FontFamily="Yu Gothic UI" FontSize="13"
                                         AutomationProperties.Name="AIモデルID" />
                                <StackPanel x:Name="CompatibleEndpointPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                    <TextBlock Text="APIのベースURL" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="ApiBaseUrlTextBox" MinHeight="40" Padding="8,7"
                                             Background="#333333" Foreground="#F4F4F4" CaretBrush="#F4F4F4"
                                             BorderBrush="#686868" FontFamily="Yu Gothic UI" FontSize="13"
                                             AutomationProperties.Name="OpenAI互換APIのベースURL" />
                                </StackPanel>
                                <TextBlock Text="APIキー" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4" />
                                <PasswordBox x:Name="ApiKeyPasswordBox" MinHeight="40" Padding="8,7"
                                             Background="#333333" Foreground="#F4F4F4" BorderBrush="#686868"
                                             FontFamily="Yu Gothic UI" FontSize="13"
                                             AutomationProperties.Name="APIキー" />
                                <TextBlock x:Name="ApiKeyStatus" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>

                            <Button x:Name="SaveAiProviderSettingsButton" Content="モデル設定を保存"
                                    MinHeight="42" Padding="16,0" Margin="0,12,0,0"
                                    HorizontalAlignment="Right" Background="#383838" Foreground="#F4F4F4"
                                    BorderBrush="#686868" BorderThickness="1" FontFamily="Yu Gothic UI"
                                    FontSize="13" Cursor="Hand" Click="SaveAiProviderSettings_Click"
                                    AutomationProperties.Name="AIサービスとモデル設定を保存" />
                        </StackPanel>
                        <TextBlock x:Name="PrivacyNotice"
                                   Text="音声と文字起こしはPC内で処理します。AIモードを使うときだけ文字起こしを選択中のサービスへ送信します。"
                                   FontSize="12" LineHeight="18" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,18,0,0" Visibility="Collapsed" />
                        <ProgressBar x:Name="SetupProgress" Height="5" Minimum="0" Maximum="100" Value="0"
                                     Visibility="Collapsed" Foreground="#EAEAEA" Background="#555555"
                                     BorderThickness="0" Margin="0,20,0,0" />
                        <TextBlock x:Name="SetupStatus" Text="" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   LineHeight="18" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="RuntimeStatus" Text="" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   LineHeight="18" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />

                    </StackPanel>
                    </ScrollViewer>

                    <Button x:Name="ActionButton" Grid.Row="2" Content="Setup" Width="210" Height="56"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButtonStyle}"
                            Click="ActionButton_Click" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
