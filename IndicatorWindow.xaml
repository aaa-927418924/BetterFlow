<Window x:Class="BetterFlow.IndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:BetterFlow.Services"
        Width="140" Height="38" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" WindowStartupLocation="Manual"
        Focusable="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="IndicatorGlassTintBrush" Color="#99111111" />
    </Window.Resources>
    <Grid x:Name="GlassRoot" IsHitTestVisible="False" SizeChanged="GlassRoot_SizeChanged">
        <Grid.Clip>
            <RectangleGeometry Rect="0,0,140,38" RadiusX="19" RadiusY="19" />
        </Grid.Clip>
        <Grid x:Name="LensBackdrop" ClipToBounds="True" Opacity="0.97">
            <Grid.Effect>
                <services:IndicatorGlassEffect x:Name="GlassRefraction" />
            </Grid.Effect>
            <Image x:Name="GlassBackdropImage" Margin="-12" Stretch="Fill" Visibility="Collapsed">
                <Image.Effect>
                    <BlurEffect Radius="12" KernelType="Gaussian" RenderingBias="Quality" />
                </Image.Effect>
            </Image>
        </Grid>
        <Border x:Name="GlassTint" CornerRadius="19"
                Background="{StaticResource IndicatorGlassTintBrush}" />
        <!-- Experimental rim is independent of the existing blur and tint. -->
        <Grid x:Name="PrismRim" ClipToBounds="True" Visibility="Collapsed">
            <Grid.Effect>
                <services:IndicatorPrismEffect x:Name="PrismRefraction" />
            </Grid.Effect>
            <Image Source="{Binding Source, ElementName=GlassBackdropImage}"
                   Margin="-12" Stretch="Fill">
                <Image.Effect>
                    <BlurEffect Radius="1.5" KernelType="Gaussian" RenderingBias="Quality" />
                </Image.Effect>
            </Image>
        </Grid>
        <Border CornerRadius="18.5" Margin="0.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#14FFFFFF" Offset="0" />
                    <GradientStop Color="#04FFFFFF" Offset="0.35" />
                    <GradientStop Color="#00FFFFFF" Offset="0.65" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border Padding="5">
        <Grid x:Name="IndicatorContent" SizeChanged="IndicatorContent_SizeChanged">
            <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left"
                    Background="#18D5E6FF" CornerRadius="14" Visibility="Collapsed"
                    UseLayoutRounding="False" SnapsToDevicePixels="False" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="26" Height="24.4" Background="White" CornerRadius="8.88"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        AutomationProperties.Name="Better Flow">
                    <Canvas Width="26" Height="24.4">
                        <Rectangle x:Name="LeftWaveBar" Canvas.Left="5.39" Canvas.Top="5.70"
                                   Width="3.49" Height="13.0" RadiusX="1.75" RadiusY="1.75" Fill="#2B2B2B" />
                        <Rectangle x:Name="CenterWaveBar" Canvas.Left="11.10" Canvas.Top="4.75"
                                   Width="3.49" Height="14.6" RadiusX="1.75" RadiusY="1.75" Fill="#2B2B2B" />
                        <Rectangle x:Name="RightWaveBar" Canvas.Left="16.80" Canvas.Top="7.60"
                                   Width="3.49" Height="9.2" RadiusX="1.75" RadiusY="1.75" Fill="#2B2B2B" />
                    </Canvas>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="録音中"
                               FontFamily="Yu Gothic UI" FontSize="9.5" FontWeight="Medium"
                               Foreground="#FFFFFF" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="NoWrap" />
                    <TextBlock x:Name="HintText" Text="右Altで確定" Visibility="Collapsed"
                               FontFamily="Yu Gothic UI" FontSize="7.5"
                               Foreground="#F1F4FC" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
